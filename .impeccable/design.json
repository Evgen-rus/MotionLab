  "narrative": {
    "northStar": "Compact NLE workspace",
    "overview": "MotionLab uses the restrained material language of a local editing desk: dark neutral work surfaces, direct controls and precise time data. The visual hierarchy gives user footage the largest quiet surface and keeps editing decisions close to their context.\n\nDensity serves the task. Tonal panels, narrow dividers and modest corners establish regions; saturated color identifies actions and state. The interface remains a browser application, without simulated operating-system window chrome.",
    "keyCharacteristics": [
      "Neutral dark panels with thin structural dividers.",
      "Blue editing actions and selection; green command application and local state.",
      "Local Manrope, compact labels and tabular time data.",
      "Real user media and state-driven metadata."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Blue identifies editing actions and selection; green identifies command application and local state.",
        "section": "colors"
      },
      {
        "name": "The Legible Hierarchy Rule",
        "body": "Use 12px or larger for primary labels; reserve 11px for secondary information.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use real source thumbnails and state-driven counts, format and export data.",
      "**Do** keep semantic controls, visible keyboard focus and reduced-motion support.",
      "**Do** preserve the distinction between primary labels and secondary metadata.",
      "**Do** keep fonts and application resources local."
    ],
    "donts": [
      "**Don't** add macOS traffic-light window controls.",
      "**Don't** use generated demo footage or invented metadata as product state.",
      "**Don't** imply multitrack audio, a mixer or unimplemented mode tabs.",
      "**Don't** introduce external font or script CDNs."
    ]
  }
}
