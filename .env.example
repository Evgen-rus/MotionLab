OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# # У каждого TTS-моделя свой voice ID; это пример для Fish Audio S2.1 Pro Free.
# cb92b10e1a5946b9b6bd7391aefe31fe голос как саендук
# 5b5ec1f32af44ee08729a3cd004eee1f — просто нормальный русский мужской голос среднего возраста, если захочется меньше мультяшности
OPENROUTER_TTS_VOICE=5b5ec1f32af44ee08729a3cd004eee1f
OPENROUTER_TTS_TIMEOUT_SECONDS=120
OWNER_VOICE_ENABLED=true
OWNER_VOICE_MAX_COST_USD=0
